.section {
  margin-bottom: var(--space-lg);
}

.optional {
  padding-left: var(--space-base);
  border-left: 4rpx solid var(--color-rank-bg);
}

.optional-label::after {
  content: "（可选）";
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-left: var(--space-sm);
}

.required .label::after {
  content: " *";
  color: var(--color-danger);
}

.label {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.input {
  background: var(--color-bg-card);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  font-size: var(--font-xl);
  border: 2rpx solid var(--color-border);
}

.readonly-text {
  background: var(--color-bg-input);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  font-size: var(--font-xl);
  color: var(--color-text-primary);
  display: block;
}

.picker {
  background: var(--color-bg-card);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  font-size: var(--font-xl);
  border: 2rpx solid var(--color-border);
  color: var(--color-text-primary);
}

.divider {
  height: 2rpx;
  background: var(--color-divider);
  margin: var(--space-xl) 0;
}

.preview {
  background: var(--color-primary-light);
  border-radius: var(--radius-field);
  padding: var(--space-base);
  margin-bottom: var(--space-xl);
}

.preview-text {
  font-size: var(--font-lg);
  color: var(--color-primary);
  display: block;
}

.per-piece {
  margin-top: var(--space-sm);
  opacity: 0.8;
}

.barcode-section {
  margin-bottom: var(--space-lg);
}

.barcode-section-title {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.barcode-row {
  display: flex;
  gap: var(--space-base);
}

.barcode-input {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  font-size: var(--font-xl);
  border: 2rpx solid var(--color-border);
}

.barcode-btn {
  background: var(--color-primary);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.barcode-btn-text {
  color: #fff;
  font-size: var(--font-lg);
  white-space: nowrap;
}

.barcode-status {
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-top: var(--space-sm);
}

.barcode-status-error {
  color: var(--color-danger);
}

.barcode-status-success {
  color: var(--color-primary);
}

.ref-price {
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-top: var(--space-sm);
}

.manual-edit {
  margin-top: var(--space-sm);
  display: inline-block;
  padding: var(--space-sm) var(--space-lg);
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-field);
}

/* OCR 拍照识别 */
.ocr-section {
  margin-bottom: var(--space-lg);
}

.ocr-section-title {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.ocr-btn-row {
  display: flex;
  gap: var(--space-base);
}

.ocr-btn {
  flex: 1;
  background: var(--color-primary);
  border-radius: var(--radius-field);
  padding: var(--space-base) var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ocr-btn-text {
  color: #fff;
  font-size: var(--font-lg);
}

.ocr-status {
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-top: var(--space-sm);
}

.ocr-status-error {
  color: var(--color-danger);
}

.ocr-autofill-hint {
  display: flex;
  align-items: center;
  background: var(--color-primary-light);
  border-radius: var(--radius-field);
  padding: var(--space-sm) var(--space-base);
  margin-bottom: var(--space-lg);
}

.ocr-autofill-icon {
  color: var(--color-primary);
  font-size: var(--font-xl);
  margin-right: var(--space-sm);
  font-weight: bold;
}

.ocr-autofill-text {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* OCR 候选文字标签 */
.ocr-tags-section {
  margin-bottom: var(--space-lg);
}

.ocr-tags-title {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-bottom: var(--space-sm);
}

.ocr-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.ocr-tag {
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-field);
  padding: var(--space-sm) var(--space-lg);
}

.ocr-tag-text {
  font-size: var(--font-base);
  color: var(--color-primary);
}

/* OCR 字段选择弹窗 */
.ocr-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.ocr-picker {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.ocr-picker-header {
  padding: var(--space-lg);
  text-align: center;
  border-bottom: 2rpx solid var(--color-divider);
}

.ocr-picker-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: bold;
  color: var(--color-text-primary);
}

.ocr-picker-selected-text {
  display: block;
  font-size: var(--font-base);
  color: var(--color-text-faint);
  margin-top: var(--space-sm);
}

.ocr-picker-options {
  padding: var(--space-base) var(--space-lg);
}

.ocr-picker-option {
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--font-xl);
  color: var(--color-text-primary);
  border-bottom: 2rpx solid var(--color-divider);
}

.ocr-picker-option:last-child {
  border-bottom: none;
}

.ocr-picker-cancel {
  padding: var(--space-lg);
  text-align: center;
  font-size: var(--font-xl);
  color: var(--color-text-faint);
  border-top: 2rpx solid var(--color-divider);
}