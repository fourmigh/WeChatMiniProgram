.loading {
  text-align: center;
  padding-top: 200rpx;
  color: var(--color-text-muted);
  font-size: var(--font-lg);
}

.header {
  display: flex;
  align-items: baseline;
  padding: var(--space-base);
}

.spec-label {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
}

.spec-value {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

.filter-row {
  white-space: nowrap;
  padding: 0 var(--space-base) var(--space-base);
}

.chip {
  display: inline-block;
  font-size: var(--font-sm);
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border-light);
}

.chip.active {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

.section-title {
  font-size: var(--font-base);
  font-weight: 500;
  color: var(--color-text-primary);
  padding: var(--space-base) var(--space-base) var(--space-sm);
}

.trend {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin: 0 var(--space-base) var(--space-base);
  padding: var(--space-lg) var(--space-base) var(--space-base);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.bars {
  display: flex;
  align-items: flex-end;
  height: 280rpx;
}

.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  min-width: 0;
}

.bar-price {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  margin-bottom: 6rpx;
  white-space: nowrap;
}

.bar-price.best {
  color: var(--color-primary);
  font-weight: 600;
}

.bar {
  width: 60%;
  max-width: 48rpx;
  background: var(--color-rank-bg);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  transition: height 0.2s;
}

.bar.best {
  background: var(--color-primary);
}

.bar-date {
  font-size: var(--font-xs);
  color: var(--color-text-faint);
  margin-top: 8rpx;
  transform: rotate(-35deg);
  transform-origin: top center;
  white-space: nowrap;
}

.timeline {
  padding: 0 var(--space-base) var(--space-base);
}

.tl-item {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-md) var(--space-lg);
  margin-bottom: var(--space-sm);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tl-date {
  width: 150rpx;
  flex-shrink: 0;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  padding-top: 4rpx;
}

.tl-body {
  flex: 1;
  min-width: 0;
}

.tl-source {
  display: flex;
  align-items: center;
  font-size: var(--font-base);
  color: var(--color-text-primary);
}

.tl-source-text {
  margin-left: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.best-badge {
  margin-left: auto;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-top-bg);
  border: 2rpx solid var(--color-top-border);
  border-radius: var(--radius-tag);
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.current-badge {
  margin-left: 8rpx;
  font-size: var(--font-xs);
  color: #fff;
  background: var(--color-text-secondary);
  border-radius: var(--radius-tag);
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.tl-price {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.tl-total {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-right: var(--space-md);
}

.tl-unit {
  font-size: var(--font-base);
  font-weight: 500;
}

.highlight {
  color: var(--color-primary);
}

.empty {
  display: block;
  text-align: center;
  color: var(--color-text-faint);
  font-size: var(--font-base);
  padding: var(--space-lg) 0;
}

.tag {
  display: inline-block;
  font-size: var(--font-xs);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-tag);
  margin-right: var(--space-xs);
  vertical-align: middle;
}

.tag.online {
  background: var(--color-tag-online-bg);
  color: var(--color-tag-online-text);
}

.tag.offline {
  background: var(--color-tag-offline-bg);
  color: var(--color-tag-offline-text);
}
