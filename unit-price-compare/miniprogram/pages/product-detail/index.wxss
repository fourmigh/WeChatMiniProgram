.loading {
  text-align: center;
  padding-top: 200rpx;
  color: var(--color-text-muted);
  font-size: var(--font-lg);
}

.product-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: var(--space-base);
  position: relative;
}

.brand {
  font-size: var(--font-base);
  color: var(--color-text-tertiary);
  display: block;
}

.name {
  font-size: var(--font-display);
  font-weight: 600;
  color: var(--color-text-primary);
}

.hint {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-faint);
  margin-bottom: var(--space-base);
}

.spec-card {
  position: relative;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-base);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.spec-title {
  font-size: var(--font-xl);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: var(--space-md);
}

.spec-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: var(--space-sm);
}

.history-link {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.price-row {
  display: flex;
  align-items: center;
  padding: var(--space-md) 0;
  font-size: var(--font-base);
}

.price-row.top-rank {
  background: var(--color-top-bg);
  border-radius: var(--radius-sm);
  padding: var(--space-md) 16rpx;
  border: 2rpx solid var(--color-top-border);
  box-sizing: border-box;
}

.price-header {
  color: var(--color-text-muted);
  border-bottom: 2rpx solid var(--color-border-light);
}

.per-piece-row {
  display: flex;
  align-items: center;
  padding: 0 0 var(--space-md) 0;
  font-size: var(--font-sm);
  margin-top: -6rpx;
}

.rank-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--color-rank-bg);
  color: var(--color-text-secondary);
  font-size: var(--font-xs);
  font-weight: 600;
}

.rank-badge.gold {
  background: var(--color-rank-gold);
  color: #fff;
}

.col {
  flex: 1;
}

.rank { width: 56rpx; flex-shrink: 0; text-align: center; }
.platform { flex: 1; }
.shop { flex: 1.2; }
.price { flex: 0.8; text-align: right; }
.unit-price { flex: 1; text-align: right; }

.highlight {
  color: var(--color-primary);
  font-weight: 500;
}

.per-piece-text {
  color: var(--color-text-muted);
}

.tag {
  display: inline-block;
  font-size: var(--font-xs);
  padding: 2rpx 8rpx;
  border-radius: var(--radius-tag);
  margin-right: var(--space-xs);
  vertical-align: middle;
}

.tag.online {
  background: var(--color-tag-online-bg);
  color: var(--color-tag-online-text);
}

.tag.offline {
  background: var(--color-tag-offline-bg);
  color: var(--color-tag-offline-text);
}