<view class="page">
  <view class="page-head page-head-row">
    <view class="head-left">
      <view class="page-title">{{T.title}}</view>
      <view class="page-sub">{{subtitle}}</view>
    </view>
    <view class="head-rank" bindtap="goRankIntro">
      <text class="lv-rank">{{currentRank}}</text>
      <view class="head-rank-label">{{T.currentRank}}</view>
    </view>
  </view>

  <view class="body-wrap">
    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="page-body" bindscroll="onScroll">
    <view class="container">
      <view class="card">
        <view class="card-head">
          <view class="section-title">{{T.singleTitle}}</view>
          <view class="muted">{{T.singleDesc}}</view>
        </view>
        <view class="char-cell-row">
          <view class="char-cell">
            <view class="cell-line h"></view>
            <view class="cell-line v"></view>
            <view class="cell-line d1"></view>
            <view class="cell-line d2"></view>
            <input
              class="cell-input"
              value="{{charInput}}"
              maxlength="2"
              bindinput="onCharInput"
            />
          </view>
      <view class="random-btn" bindtap="randomChar">{{T.random}}</view>
      <view class="poly-only {{polyOnly ? 'on' : ''}}" bindtap="onTogglePolyOnly">
        <view class="poly-box">{{polyOnly ? '✓' : ''}}</view>
        <view class="poly-text">{{T.polyOnly}}</view>
      </view>
    </view>
        <view class="char-hint">{{T.inputHint}}</view>
        <view class="btn mt" bindtap="startSingle">{{T.startSingle}}</view>
      </view>

      <view class="card">
        <view class="card-head">
          <view class="section-title">{{T.testTitle}}</view>
          <view class="muted">{{T.testDesc}}</view>
        </view>

        <view class="field-label">{{T.scopeLabel}}</view>
        <view class="chips">
          <view
            wx:for="{{scopes}}"
            wx:key="index"
            class="chip {{scopeIndex === item.index ? 'active' : ''}}"
            data-index="{{item.index}}"
            bindtap="selectScope"
          >{{item.name}} {{item.count}}</view>
        </view>
        <view class="muted scope-note">{{T.scopeNote}}</view>

        <view class="field-label">{{T.sizeLabel}}</view>
        <view class="chips">
          <view
            wx:for="{{sampleSizes}}"
            wx:key="*this"
            class="chip {{sampleSize === item ? 'active' : ''}}"
            data-size="{{item}}"
            bindtap="selectSize"
          >{{item}} {{T.charUnit}}</view>
        </view>

        <view class="btn mt" bindtap="startTest">{{T.startTest}}</view>
      </view>

      <view class="card last" wx:if="{{lastResult}}">
        <view class="row between">
          <view>
            <view class="section-title last-title">{{T.lastTitle}}</view>
            <view class="muted">{{lastResult.scopeName}} · {{lastResult.count}} {{T.charUnit}} · {{lastResult.dateText}}</view>
          </view>
          <view class="last-right">
            <view class="last-level">
              <text class="lv-mark sm lv{{lastResult.avgLevelRound}}">{{lastResult.avgMark}}</text>
              <text class="last-avg">{{lastResult.avgValue}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer footer">
    <view class="footer-link" bindtap="goIntro">{{T.footerIntro}}</view>
    <view class="footer-dot">·</view>
    <view class="footer-link" bindtap="goHistory">{{T.footerHistory}}</view>
    <view class="footer-dot">·</view>
    <view class="footer-link" bindtap="goChars">{{T.footerChars}}</view>
  </view>
</view>
