.list-head {
  flex-shrink: 0;
  padding: 0 var(--sp-lg);
}

.search-input {
  background: #ffffff;
  border: 2rpx solid #e3dbcf;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  height: 76rpx;
  box-sizing: border-box;
}

.scope-chips {
  margin-top: var(--sp-sm);
  margin-bottom: var(--sp-sm);
}

.list-hint {
  text-align: center;
  padding: 60rpx 0;
}

.cell-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin: -6rpx;
}

.char-mini {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin: 6rpx;
  border: 2rpx solid #e3dbcf;
  border-radius: 12rpx;
  background: #fbf9f4;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}

.char-mini.target {
  border-color: #c8553d;
  background: #fbeeea;
  box-shadow: 0 0 0 4rpx rgba(200, 85, 61, 0.18);
}

.mini-char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 44rpx;
  line-height: 1;
  color: #22333b;
}

.mini-level {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  line-height: 1;
  color: #ffffff;
  border-radius: 50%;
}

.list-more {
  text-align: center;
  padding: 24rpx 0 12rpx;
}
