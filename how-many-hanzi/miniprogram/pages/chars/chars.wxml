<view class="page">
  <view class="page-head">
    <view class="page-title">我的字库</view>
    <view class="page-sub">{{count}} 个字的最高等级记录</view>
  </view>

  <view class="stats-fixed" wx:if="{{hasData}}">
    <view class="card stats-card">
      <view class="row between">
        <view>
          <view class="stat-num">{{count}}</view>
          <view class="muted">已测过的字（记录最高等级）</view>
        </view>
        <view class="card-actions">
          <view class="action-link {{manage ? 'active' : ''}}" bindtap="toggleManage">{{manage ? '完成' : '管理'}}</view>
          <view class="action-link warn" bindtap="clearChars">清空</view>
        </view>
      </view>
      <view class="dist-list">
        <view class="progress-row">
          <view class="progress-label">覆盖</view>
          <view class="progress-track">
            <view class="progress-fill cov" style="width: {{coverage}}%"></view>
          </view>
          <view class="progress-text">{{count}} / {{totalChars}} · {{coverage}}%</view>
        </view>
        <view class="progress-row">
          <view class="progress-label">掌握</view>
          <view class="progress-track">
            <view class="progress-fill mas" style="width: {{mastery}}%"></view>
          </view>
          <view class="progress-text">{{mastery}}%</view>
        </view>
        <view class="rank-line">
          <text class="lv-rank">{{rank}}</text>
          <text class="rank-sub">当前功名</text>
        </view>
        <view class="dist-row" wx:for="{{dist}}" wx:key="level" wx:if="{{item.count > 0}}">
          <view class="dist-label">
            <text class="lv-mark sm lv{{item.level}}">{{item.mark}}</text>
          </view>
          <view class="dist-track">
            <view class="dist-fill lv{{item.level}}" style="width: {{item.pct}}%"></view>
          </view>
          <view class="dist-count">{{item.count}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="body-wrap">
    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="page-body" bindscroll="onScroll">
    <view class="container">
      <block wx:if="{{hasData}}">
        <view class="card" wx:for="{{groups}}" wx:key="level" wx:for-item="g">
          <view class="section-title">
            <text class="lv-mark sm lv{{g.level}}">{{g.mark}}</text>
            <text class="section-title-text">· {{g.name}} · {{g.chars.length}}</text>
          </view>
          <view class="cell-grid">
            <view
              class="char-mini {{manage ? 'manage' : ''}}"
              wx:for="{{g.chars}}"
              wx:for-item="c"
              wx:key="char"
              data-char="{{c.char}}"
              bindtap="onMiniTap"
            >
              <view class="mini-char">{{c.char}}</view>
              <view class="mini-level lv{{c.level}}">{{c.mark}}</view>
              <view class="mini-del" wx:if="{{manage}}">×</view>
            </view>
          </view>
        </view>

        <view class="muted chars-tip">点击任意字重新测级；点「管理」可删除单个字。</view>
      </block>

      <view class="empty" wx:else>
        <view class="empty-title">还没有测过字</view>
        <view class="muted">回到首页测一个字，或做一次整体自测。</view>
      </view>
    </view>
  </scroll-view>
    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">回首页</view>
  </view>
</view>
