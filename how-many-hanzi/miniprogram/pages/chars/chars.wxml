<view class="page">
  <view class="page-head">
    <view class="page-title">{{T.title}}</view>
    <view class="page-sub">{{subtitle}}</view>
  </view>

  <view class="stats-fixed" wx:if="{{hasData}}">
    <view class="card stats-card">
      <view class="row between">
        <view>
          <view class="stat-num">{{count}}</view>
          <view class="muted">{{T.testedLabel}}</view>
        </view>
        <view class="card-actions">
          <view class="action-link {{manage ? 'active' : ''}}" bindtap="toggleManage">{{manage ? T.done : T.manage}}</view>
          <view class="action-link warn" bindtap="clearChars">{{T.clear}}</view>
        </view>
      </view>
      <view class="dist-list">
        <view class="progress-row">
          <view class="progress-label">{{T.coverage}}</view>
          <view class="progress-track">
            <view class="progress-fill cov" style="width: {{coverage}}%"></view>
          </view>
          <view class="progress-text">{{count}} / {{totalChars}} · {{coverage}}%</view>
        </view>
        <view class="progress-row">
          <view class="progress-label">{{T.mastery}}</view>
          <view class="progress-track">
            <view class="progress-fill mas" style="width: {{mastery}}%"></view>
          </view>
          <view class="progress-text">{{mastery}}%</view>
        </view>
        <view class="rank-line">
          <text class="lv-rank">{{rank}}</text>
          <text class="rank-sub">{{T.currentRank}}</text>
        </view>
        <view class="dist-row" wx:for="{{dist}}" wx:key="level" wx:if="{{item.count > 0}}">
          <view class="dist-label">
            <text class="lv-mark sm lv{{item.level}}">{{item.mark}}</text>
          </view>
          <view class="dist-track">
            <view class="dist-fill lv{{item.level}}" style="width: {{item.pct}}%"></view>
          </view>
          <view class="dist-count">{{item.count}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="rare-fixed">
    <view class="card rare-card" bindtap="goRare">
      <view class="rare-entry-left">
        <text class="rare-entry-title">{{T.hidden}}</text>
        <text class="rare-entry-sub">{{T.hiddenSub}}</text>
      </view>
      <view class="rare-entry-right">
        <text class="rare-entry-count">{{rareCount}} {{T.charUnit}}</text>
        <text class="rare-entry-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="body-wrap">
    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="page-body" bindscroll="onScroll">
    <view class="container">
      <block wx:if="{{hasData}}">
        <view class="card" wx:for="{{groups}}" wx:key="level" wx:for-item="g">
          <view class="section-title">
            <text class="lv-mark sm lv{{g.level}}">{{g.mark}}</text>
            <text class="section-title-text">· {{g.name}} · {{g.chars.length}}</text>
          </view>
          <view class="cell-grid">
            <view
              class="char-mini {{manage ? 'manage' : ''}}"
              wx:for="{{g.chars}}"
              wx:for-item="c"
              wx:key="char"
              data-char="{{c.char}}"
              bindtap="onMiniTap"
            >
              <view class="mini-char">{{c.char}}</view>
              <view class="mini-level lv{{c.level}}">{{c.mark}}</view>
              <view class="mini-del" wx:if="{{manage}}">×</view>
            </view>
          </view>
        </view>

        <view class="muted chars-tip">{{T.tip}}</view>
      </block>

      <view class="empty" wx:else>
        <view class="empty-title">{{T.emptyTitle}}</view>
        <view class="muted">{{T.emptyDesc}}</view>
        <view class="muted" wx:if="{{rareCount}}">{{emptyRare}}</view>
      </view>
    </view>
  </scroll-view>
    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">{{T.home}}</view>
  </view>
</view>
