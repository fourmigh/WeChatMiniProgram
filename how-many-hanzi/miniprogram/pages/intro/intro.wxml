<view class="page">
  <view class="page-head">
    <view class="page-title">{{T.title}}</view>
    <view class="page-sub">{{subtitle}}</view>
  </view>

  <view class="body-wrap">
    <scroll-view
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    class="page-body"
    scroll-into-view="{{intoView}}"
    bindscroll="onScroll"
  >
    <view class="container">
      <view class="card">
        <view class="muted level-note">{{T.markNote}}</view>
        <view class="level-item" wx:for="{{levels}}" wx:key="n">
          <view class="level-no">
            <text class="lv-mark lv{{item.n}}">{{item.mark}}</text>
          </view>
          <view class="level-body">
            <view class="level-head">{{item.name}}</view>
            <view class="level-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>

      <view class="card" id="rank-card">
        <view class="section-title">{{T.rankTitle}}</view>
        <view class="muted">{{T.rankIntro}}</view>
        <view class="rank-row" wx:for="{{ranks}}" wx:key="name">
          <view class="rank-name"><text class="lv-rank sm">{{item.name}}</text></view>
          <view class="rank-range">{{item.range}}</view>
          <view class="rank-desc">{{item.desc}}</view>
        </view>
        <view class="rule">{{zeroRule}}</view>
        <view class="rule">{{T.rankRuleFormula}}</view>
        <view class="muted mt">{{T.rankNote}}</view>
      </view>

      <view class="card">
        <view class="section-title">{{T.scopeTitle}}</view>
        <view
          class="scope-row"
          wx:for="{{scopes}}"
          wx:key="index"
          data-index="{{item.index}}"
          bindtap="openScope"
        >
          <view class="scope-name">{{item.name}}</view>
          <view class="scope-count">{{item.count}} {{T.charUnit}} ›</view>
        </view>
        <view class="muted mt">{{scopeNoteAll}}</view>
        <view class="muted mt">{{T.scopeNoteCumulative}}</view>
      </view>

      <view class="card">
        <view class="section-title">{{T.scoringTitle}}</view>
        <view class="rule">{{T.rule1}}</view>
        <view class="rule">{{T.rule2}}</view>
        <view class="rule">{{T.rule3}}</view>
        <view class="rule">{{T.rule4}}</view>
      </view>
    </view>
  </scroll-view>
    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">{{T.home}}</view>
  </view>
</view>
