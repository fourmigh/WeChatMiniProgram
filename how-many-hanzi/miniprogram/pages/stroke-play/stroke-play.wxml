<view class="page">
  <view class="body-wrap">
    <scroll-view
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      class="page-body"
    >
      <view class="container">
        <view class="play-stage">
          <canvas
            type="2d"
            id="playCanvas"
            class="play-canvas"
            style="height: {{stageRpx}}rpx"
            bindtouchend="onCanvasTouchEnd"
          ></canvas>

          <view class="caption" wx:if="{{status === 'ready'}}">
            <text class="caption-main">{{caption}}</text>
            <text class="caption-sub">{{T.tapHint}}</text>
          </view>

          <view class="stage-hint" wx:elif="{{status === 'loading'}}">
            {{T.loading}}
          </view>

          <view class="stage-hint" wx:else>
            <text>{{status === 'missing' ? T.missing : T.error}}</text>
            <text class="stage-retry" bindtap="retry">{{T.retry}}</text>
          </view>
        </view>

        <view class="controls" wx:if="{{status === 'ready'}}">
          <view class="nav-row">
            <view class="ctrl-btn" bindtap="prevStroke">{{T.prev}}</view>
            <view class="progress">{{cursor + 1}} / {{total}}</view>
            <view class="ctrl-btn" bindtap="nextStroke">{{T.next}}</view>
          </view>

          <view class="replay-row">
            <view class="ctrl-btn" bindtap="rewriteStroke">{{T.rewriteStroke}}</view>
            <view class="ctrl-btn primary" bindtap="replay">{{T.replayAll}}</view>
          </view>

          <view class="duration-row">
            <text class="duration-label">{{T.durationLabel}}</text>
            <slider
              class="duration-slider"
              min="300"
              max="3000"
              step="100"
              value="{{duration}}"
              activeColor="#c8553d"
              backgroundColor="#e7dfd1"
              block-size="20"
              bindchanging="onDurationChanging"
              bindchange="onDurationChange"
            ></slider>
            <text class="duration-value">{{durationText}}</text>
          </view>

          <view class="pause-row">
            <text class="pause-label">{{T.pauseLabel}}</text>
            <switch
              checked="{{pause}}"
              color="#c8553d"
              bindchange="onPauseChange"
            />
          </view>

          <scroll-view
            scroll-x
            enhanced="{{true}}"
            show-scrollbar="{{false}}"
            class="chips-scroll"
          >
            <view class="chips stroke-chips">
              <view
                wx:for="{{strokeNames}}"
                wx:key="no"
                class="chip stroke-chip {{item.no - 1 === cursor ? 'active' : ''}}"
                data-index="{{item.no - 1}}"
                bindtap="selectStroke"
              >{{item.no}} {{item.name}}</view>
            </view>
          </scroll-view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
