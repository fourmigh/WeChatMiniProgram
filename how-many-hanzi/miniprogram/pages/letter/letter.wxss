.bar {
  position: fixed;
  left: var(--sp-lg);
  right: var(--sp-lg);
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 18rpx var(--sp-md);
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(34, 51, 59, 0.06);
}

.bar-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #22333b;
}

.bar-status {
  flex: 1;
  margin-left: var(--sp-sm);
  font-size: 22rpx;
  color: #7a858c;
  text-align: right;
}

.bar-arrow {
  margin-left: var(--sp-2xs);
  font-size: 26rpx;
  color: #c8553d;
  line-height: 1;
}

.paper-stage {
  position: relative;
  padding: 48rpx var(--sp-lg) calc(130rpx + env(safe-area-inset-bottom));
}

.editor {
  margin: 0 var(--sp-lg) calc(24rpx + env(safe-area-inset-bottom));
  padding: var(--sp-md);
}

/* 配置面板：从底部升起的卡片，信纸露在上方 */
.editor-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
}

.editor-scroll {
  max-height: 62vh;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-head .section-title {
  margin-bottom: var(--sp-sm);
}

.collapse {
  padding: 4rpx 0 4rpx var(--sp-sm);
  font-size: 24rpx;
  font-weight: 600;
  color: #c8553d;
}

.letter-input {
  box-sizing: border-box;
  width: 100%;
  height: 420rpx;
  margin: 0;
  padding: var(--sp-xs);
  background: #fbf7ef;
  border: 2rpx solid #ede5d8;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #22333b;
}

.letter-placeholder {
  color: #c9c2b6;
}

.setting-row {
  display: flex;
  align-items: center;
  margin-top: var(--sp-md);
}

.setting-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 24rpx;
  color: #55636b;
}

.cols-note {
  margin-top: var(--sp-sm);
  text-align: center;
  font-size: 24rpx;
  color: #7a858c;
}

.setting-slider {
  flex: 1;
  margin: 0 var(--sp-lg);
}

.setting-value {
  width: 96rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #22333b;
}

.letter-btn {
  margin-top: var(--sp-md);
}

.paper-card {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(34, 51, 59, 0.06);
}

.letter-canvas {
  display: block;
  width: 100%;
  background: #fbf7ef;
}
