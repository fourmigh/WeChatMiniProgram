<view class="page">
  <view class="page-head">
    <view class="page-title">历史记录</view>
    <view class="page-sub">自测成绩与最近测过的字</view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="page-body">
    <view class="container">
      <block wx:if="{{hasData || hasRecent}}">
        <view class="card" wx:if="{{hasRecent}}">
          <view class="row between">
            <view class="section-title">最近测过的字</view>
            <view class="recent-more" bindtap="goChars">全部 ›</view>
          </view>
          <scroll-view scroll-x class="recent-strip">
            <view
              class="recent-cell"
              wx:for="{{recent}}"
              wx:key="id"
              data-char="{{item.char}}"
              bindtap="retryChar"
            >
              <view class="recent-char">{{item.char}}</view>
              <view class="recent-level lv{{item.level}}">L{{item.level}}</view>
            </view>
          </scroll-view>
        </view>

        <block wx:if="{{hasData}}">
          <view class="card record" wx:for="{{list}}" wx:key="createdAt" wx:for-index="idx">
            <view class="record-del" data-index="{{idx}}" bindtap="deleteRecord">×</view>
            <view class="row between">
              <view>
                <view class="record-level">{{item.avgLevelText}}</view>
                <view class="muted">{{item.scopeName}} · {{item.count}} 字</view>
              </view>
              <view class="record-right">
                <view class="record-mastery">{{item.mastery}}%</view>
                <view class="muted">掌握度</view>
              </view>
            </view>
            <view class="record-foot">
              <view class="muted">估算认识 {{item.estimated}} 字</view>
              <view class="muted">{{item.dateText}}</view>
            </view>
          </view>

          <view class="btn ghost mt" bindtap="clearAll">清空全部</view>
        </block>
      </block>

      <view class="empty" wx:else>
        <view class="empty-title">还没有测字记录</view>
        <view class="muted">测一个字或做一次整体自测，就会出现在这里。</view>
      </view>
    </view>
  </scroll-view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">回首页</view>
  </view>
</view>
