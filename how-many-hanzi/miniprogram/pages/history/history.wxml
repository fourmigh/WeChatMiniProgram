<view class="container">
  <block wx:if="{{hasData}}">
    <view class="card record" wx:for="{{list}}" wx:key="createdAt">
      <view class="row between">
        <view>
          <view class="record-level">{{item.avgLevelText}}</view>
          <view class="muted">{{item.scopeName}} · {{item.count}} 字</view>
        </view>
        <view class="record-right">
          <view class="record-mastery">{{item.mastery}}%</view>
          <view class="muted">掌握度</view>
        </view>
      </view>
      <view class="record-foot">
        <view class="muted">估算认识 {{item.estimated}} 字</view>
        <view class="muted">{{item.dateText}}</view>
      </view>
    </view>

    <view class="btn ghost mt" bindtap="clearAll">清空记录</view>
  </block>

  <view class="empty" wx:else>
    <view class="empty-title">还没有自测记录</view>
    <view class="muted">回到首页开始一次整体自测吧。</view>
  </view>
</view>
