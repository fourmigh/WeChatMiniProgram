<view class="page">
  <view class="page-head">
    <view class="page-title">{{T.title}}</view>
    <view class="page-sub">{{T.subtitle}}</view>
  </view>

  <view class="body-wrap">
    <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="page-body" bindscroll="onScroll">
    <view class="container">
      <block wx:if="{{hasDays}}">
        <view class="card day-card" wx:for="{{days}}" wx:key="day">
          <view class="row between">
            <view class="day-label">{{item.label}}</view>
            <view class="muted">{{item.chars.length}} {{T.charUnitGe}}</view>
          </view>
          <view class="day-chars">
            <view
              class="recent-cell"
              wx:for="{{item.chars}}"
              wx:for-item="c"
              wx:key="id"
              data-char="{{c.char}}"
              bindtap="retryChar"
            >
              <view class="recent-char">{{c.char}}</view>
              <view class="lv-mark sm lv{{c.level}}">{{c.mark}}</view>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{hasData}}">
        <view class="card record" wx:for="{{list}}" wx:key="createdAt" wx:for-index="idx">
          <view class="record-del" data-index="{{idx}}" bindtap="deleteRecord">×</view>
          <view class="row between">
            <view>
              <view class="record-level">
                <text class="lv-mark sm lv{{item.avgLevelRound}}">{{item.avgMark}}</text>
                <text class="record-avg">{{item.avgValue}}</text>
              </view>
              <view class="muted">{{item.scopeName}} · {{item.count}} {{T.charUnit}}</view>
            </view>
            <view class="record-right">
              <view class="record-mastery">{{item.mastery}}%</view>
              <view class="muted">{{T.mastery}}</view>
            </view>
          </view>
          <view class="record-foot">
            <view class="muted">{{T.estimatedLabel}} {{item.estimated}} {{T.charUnit}}</view>
            <view class="muted">{{item.dateText}}</view>
          </view>
        </view>
      </block>

      <view class="btn ghost mt" wx:if="{{hasData || hasDays}}" bindtap="clearAll">{{T.clearAll}}</view>

      <view class="empty" wx:if="{{!hasData && !hasDays}}">
        <view class="empty-title">{{T.emptyTitle}}</view>
        <view class="muted">{{T.emptyDesc}}</view>
      </view>
    </view>
  </scroll-view>
    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">{{T.home}}</view>
  </view>
</view>
