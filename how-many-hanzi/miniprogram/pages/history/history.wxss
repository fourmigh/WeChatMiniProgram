.day-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #22333b;
}

.day-chars {
  display: flex;
  flex-wrap: wrap;
  margin: calc(var(--sp-2xs) * -1);
  margin-top: var(--sp-2xs);
}

.recent-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
  height: 104rpx;
  border: 2rpx solid #e3dbcf;
  border-radius: 12rpx;
  margin: 6rpx;
  overflow: hidden;
  background: #fbf9f4;
}

.recent-char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
  line-height: 1.1;
  color: #22333b;
  margin-top: 12rpx;
}

.recent-cell .lv-mark {
  margin-top: auto;
  margin-bottom: 8rpx;
}

.record-level {
  display: flex;
  align-items: center;
  line-height: 1.2;
}

.record-avg {
  margin-left: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #22333b;
}

.record {
  position: relative;
}

.record-del {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: #b0a89c;
  font-size: 34rpx;
  border-radius: 50%;
}

.record-del:active {
  color: #c8553d;
}

.record-right {
  text-align: right;
  padding-right: 44rpx;
}

.record-mastery {
  font-size: 40rpx;
  font-weight: 700;
  color: #c8553d;
  line-height: 1.2;
}

.record-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0ebe2;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
