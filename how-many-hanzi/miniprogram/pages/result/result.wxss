.single-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(34, 51, 59, 0.06);
  margin-bottom: var(--sp-md);
}

.big-char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 150rpx;
  line-height: 1.1;
  color: #22333b;
}

.level-name {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a858c;
  text-align: center;
  padding: 0 48rpx;
}

.log-grid {
  display: flex;
  flex-wrap: wrap;
  margin: calc(var(--sp-2xs) * -1);
}

.log-item {
  width: calc(33.33% - 16rpx);
  margin: var(--sp-2xs);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: #f7f3ec;
}

.log-item.ok {
  background: #eaf3ee;
}

.log-item.bad {
  background: #fbeeea;
}

.log-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #22333b;
}

.log-name {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #55636b;
}

.log-item.ok .log-label,
.log-item.ok .log-name,
.log-item.ok .log-state {
  color: #2f6b4f;
}

.log-item.bad .log-label,
.log-item.bad .log-name,
.log-item.bad .log-state {
  color: #c8553d;
}

.log-state {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.avg {
  font-size: 64rpx;
  font-weight: 700;
  color: #22333b;
  line-height: 1.2;
}

.mastery {
  text-align: right;
}

.mastery-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #c8553d;
  line-height: 1.2;
}

.rank-tag {
  margin-top: 4rpx;
  display: flex;
  justify-content: flex-end;
}

.divider {
  height: 1rpx;
  background: #f0ebe2;
  margin: var(--sp-sm) 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #22333b;
}

.bar-grid {
  display: flex;
  flex-wrap: wrap;
  margin: calc(var(--sp-2xs) * -1);
}

.bar-item {
  width: calc(50% - 16rpx);
  margin: var(--sp-2xs);
  box-sizing: border-box;
}

.bar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bar-label {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #55636b;
}

.bar-label-text {
  margin-left: 6rpx;
}

.bar-count {
  font-size: 22rpx;
  color: #7a858c;
}

.bar-track {
  margin-top: 4rpx;
  height: 14rpx;
  background: #f0ebe2;
  border-radius: 7rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #2f6b4f;
  border-radius: 7rpx;
  min-width: 6rpx;
}

.bar-fill.gray {
  background: #bbb2a4;
}

.btn-row {
  display: flex;
  margin-top: var(--sp-md);
}

.btn-row .btn {
  flex: 1;
}

.btn-row .btn + .btn {
  margin-left: var(--sp-sm);
}
