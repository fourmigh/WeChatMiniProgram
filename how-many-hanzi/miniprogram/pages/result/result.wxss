.single-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(34, 51, 59, 0.06);
  margin-bottom: 28rpx;
}

.big-char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 220rpx;
  line-height: 1.1;
  color: #22333b;
}

.level-pill {
  margin-top: 12rpx;
  background: #c8553d;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 4rpx 32rpx;
}

.level-name {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a858c;
  text-align: center;
  padding: 0 48rpx;
}

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0ebe2;
}

.log-row:last-child {
  border-bottom: none;
}

.log-level {
  font-size: 28rpx;
  color: #22333b;
}

.log-text {
  font-size: 26rpx;
  font-weight: 600;
}

.log-text.ok {
  color: #2f6b4f;
}

.log-text.bad {
  color: #c8553d;
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.avg {
  font-size: 72rpx;
  font-weight: 700;
  color: #22333b;
  line-height: 1.2;
}

.mastery {
  text-align: right;
}

.mastery-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #c8553d;
  line-height: 1.2;
}

.divider {
  height: 1rpx;
  background: #f0ebe2;
  margin: 28rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #22333b;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.bar-label {
  width: 150rpx;
  font-size: 24rpx;
  color: #55636b;
}

.bar-track {
  flex: 1;
  height: 20rpx;
  background: #f0ebe2;
  border-radius: 10rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #2f6b4f;
  border-radius: 10rpx;
  min-width: 6rpx;
}

.bar-fill.gray {
  background: #bbb2a4;
}

.bar-count {
  width: 56rpx;
  text-align: right;
  font-size: 24rpx;
  color: #7a858c;
}
