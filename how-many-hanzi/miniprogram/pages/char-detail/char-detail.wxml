<view class="page">
  <view class="page-head detail-head">
    <view class="detail-nav">
      <view class="nav-btn {{hasPrev ? '' : 'disabled'}}" bindtap="goPrev">{{T.prev}}</view>
      <view class="muted">{{index + 1}} / {{poolLen}}</view>
      <view class="nav-btn {{hasNext ? '' : 'disabled'}}" bindtap="goNext">{{T.next}}</view>
    </view>
  </view>

  <view class="detail-hero">
    <view class="big-char">{{char}}</view>
    <view class="hero-meta" wx:if="{{mark}}">
      <text class="lv-mark lv{{level}}">{{mark}}</text>
      <text class="hero-level">{{levelName}}</text>
      <text class="tier-tag" wx:if="{{tierName}}">{{tierName}}</text>
      <text class="tier-tag rare" wx:if="{{isHidden}}">{{T.hidden}}</text>
    </view>
    <view class="hero-meta" wx:else>
      <text class="muted" wx:if="{{!isHidden}}">{{T.notTested}}</text>
      <text class="tier-tag" wx:if="{{tierName}}">{{tierName}}</text>
      <text class="tier-tag rare" wx:if="{{isHidden}}">{{T.hidden}}</text>
    </view>
    <view class="rare-date" wx:if="{{isHidden && rareDate}}">{{rareDate}} {{T.collectedSuffix}}</view>
  </view>

  <view class="body-wrap">
    <scroll-view
      scroll-y
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      class="page-body"
      scroll-into-view="{{intoView}}"
      bindscroll="onScroll"
    >
      <view class="container">
        <view id="detail-top"></view>

      <view class="card" wx:if="{{readings.length}}">
        <view class="section-title">{{T.readingTitle}}</view>
        <view class="chip-line">
          <text class="reading-chip" wx:for="{{readings}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="muted mt" wx:if="{{isPoly}}">{{polyText}}</view>
      </view>

      <view class="card">
        <view class="section-head">
          <view class="section-title">{{T.strokeOrderTitle}}</view>
          <view class="section-hint" wx:if="{{strokeStatus === 'ready'}}">{{T.strokePlayHint}}</view>
        </view>

        <view class="stroke-stage" wx:if="{{strokeStatus === 'ready'}}">
          <canvas
            type="2d"
            id="strokeCanvas"
            class="stroke-canvas"
            style="height: {{canvasHeightRpx}}rpx"
            bindtouchend="onStrokeCellTap"
          ></canvas>
          <view class="stroke-legend">
            <view class="legend-item">
              <view class="legend-dot done"></view>
              <text>{{T.legendDone}}</text>
            </view>
            <view class="legend-item">
              <view class="legend-dot current"></view>
              <text>{{T.legendCurrent}}</text>
            </view>
            <view class="legend-item">
              <view class="legend-dot pending"></view>
              <text>{{T.legendPending}}</text>
            </view>
          </view>
        </view>

        <view class="stroke-hint" wx:elif="{{strokeStatus === 'loading'}}">
          {{T.strokeLoading}}
        </view>

        <view class="stroke-hint" wx:else>
          <text>{{strokeStatus === 'missing' ? T.strokeMissing : T.strokeError}}</text>
          <text class="stroke-retry" bindtap="retryStrokes">{{T.strokeRetry}}</text>
        </view>

        <view class="stroke-list mt" wx:if="{{strokeNames.length}}">
          <view class="stroke-item" wx:for="{{strokeNames}}" wx:key="no">
            <text class="stroke-no">{{item.no}}</text>
            <text class="stroke-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="card" wx:if="{{senses.length}}">
        <view class="section-title">{{T.sensesTitle}}</view>
        <view class="sense-row" wx:for="{{senses}}" wx:key="p">
          <text class="sense-p">{{item.p}}</text>
          <text class="sense-m">{{item.m}}</text>
        </view>
      </view>

      <view class="card" wx:if="{{explain}}">
        <view class="section-title">{{T.explainTitle}}</view>
        <view class="detail-text">{{explain}}</view>
      </view>

      <view class="card" wx:if="{{radical || strokes}}">
        <view class="section-title">{{T.shapeTitle}}</view>
        <view class="info-row" wx:if="{{radical}}">
          <text class="info-label">{{T.radical}}</text>
          <text class="info-value">{{radical}}</text>
        </view>
        <view class="info-row" wx:if="{{strokes}}">
          <text class="info-label">{{T.strokes}}</text>
          <text class="info-value">{{strokes}} {{T.strokeUnit}}</text>
        </view>
      </view>

      <view class="card" wx:if="{{words.length}}">
        <view class="section-title">{{T.wordsTitle}}</view>
        <view class="chip-line">
          <text class="word-chip" wx:for="{{words}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
    </scroll-view>

    <view class="scrollbar {{showBar ? 'show' : ''}}">
      <view class="scrollbar-thumb" style="top: {{barTop}}%; height: {{barHeight}}%"></view>
    </view>
  </view>

  <view class="page-footer">
    <view class="btn ghost" bindtap="goHome">{{T.home}}</view>
  </view>
</view>
