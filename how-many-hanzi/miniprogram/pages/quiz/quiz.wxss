.quiz-head {
  flex-shrink: 0;
  padding: 0 var(--sp-lg);
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  padding: 8rpx 0 16rpx;
  box-sizing: content-box;
}

.progress-text {
  font-size: 26rpx;
  color: #7a858c;
}

.level-track {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 8rpx 20rpx;
}

.level-seg {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ddd5c8;
  margin-bottom: 8rpx;
}

.level-seg.on .dot {
  background: #2f6b4f;
}

.level-seg.cur .dot {
  background: #c8553d;
  transform: scale(1.35);
}

.seg-label {
  font-size: 22rpx;
  color: #a29a8e;
}

.level-seg.on .seg-label {
  color: #2f6b4f;
}

.level-seg.cur .seg-label {
  color: #c8553d;
  font-weight: 600;
}

.char-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 250rpx;
  padding: 0;
}

.char {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 150rpx;
  line-height: 1.1;
  color: #22333b;
}

.level-tag {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a29a8e;
  letter-spacing: 1rpx;
}

.level-tag-text {
  margin-left: 8rpx;
}

.quiz-content {
  padding: 0 var(--sp-lg) var(--sp-md);
}

.prompt {
  text-align: center;
  font-size: 30rpx;
  color: #55636b;
  margin: 12rpx 0 28rpx;
}

.submit-btn {
  margin-top: var(--sp-md);
}

.quiz-pad {
  height: var(--sp-md);
}

.options {
  display: flex;
  flex-direction: column;
}

.options.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.option {
  position: relative;
  background: #ffffff;
  border: 2rpx solid #e3dbcf;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.options.grid .option {
  width: calc(50% - 12rpx);
  height: 168rpx;
  padding: 8rpx 12rpx;
}

.option-text {
  font-size: 32rpx;
  color: #22333b;
  text-align: center;
  word-break: break-all;
  line-height: 1.4;
}

.opt-l1 .option-text {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 64rpx;
}

.opt-l2 .option-text {
  font-size: 36rpx;
}

.opt-l3 .option-text {
  font-size: 32rpx;
}

.opt-l7 .option-text {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-size: 48rpx;
}

.option.selected {
  border-color: #22333b;
  background: #f0eee9;
}

.option.right {
  border-color: #2f6b4f;
  background: #eaf3ee;
}

.option.right .option-text {
  color: #2f6b4f;
  font-weight: 600;
}

.option.wrong {
  border-color: #c8553d;
  background: #fbeeea;
}

.option.wrong .option-text {
  color: #c8553d;
}

.check {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  color: #22333b;
  font-size: 24rpx;
  line-height: 1;
}

.feedback-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(34, 51, 59, 0.12);
  animation: slide-up 0.22s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(48rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.feedback-title {
  font-size: 32rpx;
  font-weight: 700;
}

.feedback-panel.ok .feedback-title {
  color: #2f6b4f;
}

.feedback-panel.bad .feedback-title {
  color: #c8553d;
}

.feedback-sub {
  font-size: 26rpx;
  color: #55636b;
}

.feedback-answer {
  font-size: 26rpx;
  color: #7a858c;
  margin-top: 14rpx;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.panel-btn {
  margin-top: 24rpx;
}
