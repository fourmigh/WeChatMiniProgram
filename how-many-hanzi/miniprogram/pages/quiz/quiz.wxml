<view class="page quiz">
  <view class="quiz-head">
    <view class="top-bar">
      <view class="progress-text">{{progressText}}</view>
      <view class="level-badge">L{{level}}</view>
    </view>

    <view class="level-track">
      <view
        wx:for="{{levels}}"
        wx:key="n"
        class="level-seg {{item.n <= level ? 'on' : ''}} {{question && item.n === question.level ? 'cur' : ''}}"
      >
        <view class="dot"></view>
        <view class="seg-label">{{item.label}}</view>
      </view>
    </view>

    <view class="char-stage">
      <view class="char">{{char}}</view>
      <view class="level-tag" wx:if="{{question}}">L{{question.level}} · {{question.levelName}}</view>
    </view>
  </view>

  <scroll-view
    scroll-y
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    class="page-body"
    scroll-top="{{scrollTop}}"
  >
    <view class="quiz-content">
      <view class="prompt" wx:if="{{question}}">{{question.question}}</view>

      <view class="options {{layout === 'grid' ? 'grid' : ''}}">
        <view
          wx:for="{{optionViews}}"
          wx:key="value"
          class="option opt-l{{question.level}} {{item.state}}"
          data-value="{{item.value}}"
          bindtap="onOption"
        >
          <text class="option-text">{{item.label}}</text>
          <view class="check" wx:if="{{question && question.type === 'multi' && item.state === 'selected'}}">✓</view>
        </view>
      </view>

      <view
        wx:if="{{multi && !answered}}"
        class="btn submit-btn {{selected.length ? '' : 'disabled'}}"
        bindtap="submitAnswer"
      >提交答案</view>
      <view class="quiz-pad"></view>
    </view>
  </scroll-view>

  <view wx:if="{{answered}}" class="feedback-panel {{isCorrect ? 'ok' : 'bad'}}">
    <view class="panel-head">
      <view class="feedback-title">{{feedback}}</view>
      <view class="feedback-sub">{{feedbackSub}}</view>
    </view>
    <view class="feedback-answer">正确答案：{{answerText}}</view>
    <view class="btn panel-btn" bindtap="next">{{nextText}}</view>
  </view>
</view>
